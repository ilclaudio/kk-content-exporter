# Git ignore rules of the KK Content Exporter plugin repository.
# Required entries are checked by tests/unit/KKCE_Git_Ignore_Unit_Test.php.

# Credentials and local configuration: never commit
tests/integration/wp-tests-config.local.php
wp-config.php
.env
.env.*
!.env.example

# Composer
/vendor/
.composer-cache/
.composer-home/

# Tool caches
.phpunit.cache/
.phpunit.result.cache
tests/integration/.cache/

# Generated release folder, ZIP, SVN working copy and reports
/build/

# Node (no JavaScript build yet)
node_modules/

# Logs
*.log

# Private working material and local AI state
DEV
AGENTS/ISSUES_TODO.md
AGENTS/ISSUES_RESOLVED.md
AGENTS/CODE_REVIEW_PROGRESS.md
.claude
.codex
.codex-tmp

# Editors and operating systems
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
