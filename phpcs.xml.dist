<?xml version="1.0"?>
<ruleset name="KK Content Exporter">
	<description>WordPress Coding Standards for the KK Content Exporter plugin.</description>

	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpunit.cache/phpcs.cache"/>

	<file>.</file>

	<!-- Third-party, generated, private and tooling files: see "Third-party, generated and private files" in AGENTS/AI_BEHAVIOR.md. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/DEV/*</exclude-pattern>
	<exclude-pattern>*/.git/*</exclude-pattern>
	<exclude-pattern>*/.phpunit.cache/*</exclude-pattern>
	<exclude-pattern>*/.claude/*</exclude-pattern>
	<exclude-pattern>*/.codex/*</exclude-pattern>
	<exclude-pattern>*/.codex-tmp/*</exclude-pattern>
	<exclude-pattern>*/.composer-cache/*</exclude-pattern>
	<exclude-pattern>*/.composer-home/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<!-- Development-only tooling (command-line scripts and test suites): never loaded by WordPress, never shipped. -->
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/bin/*</exclude-pattern>

	<!-- WordPress = WordPress-Core + WordPress-Docs + WordPress-Extra; listed explicitly for clarity. -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress"/>

	<!-- Operator-approved: assess meta-query performance with measurements, not field-name heuristics. -->
	<rule ref="WordPress.DB.SlowDBQuery">
		<severity>0</severity>
	</rule>

	<!-- PHP and WordPress compatibility with the declared minimums (PHP 8.3, WordPress 6.4). -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.3-"/>
	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="kk-content-exporter"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="kkce"/>
				<element value="KKCE"/>
			</property>
		</properties>
	</rule>
</ruleset>
