{
	"name": "kk-content-exporter-tests",
	"private": true,
	"description": "Development test tools of the KK Content Exporter plugin (wp-env, Playwright). Never shipped.",
	"license": "GPL-3.0-or-later",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"env:start": "wp-env start --config=.wp-env.e2etest.json",
		"env:stop": "wp-env stop --config=.wp-env.e2etest.json",
		"env:destroy": "wp-env destroy --force --config=.wp-env.e2etest.json",
		"env:tests:start": "wp-env start --config=.wp-env.inttest.json",
		"env:tests:stop": "wp-env stop --config=.wp-env.inttest.json",
		"env:tests:destroy": "wp-env destroy --force --config=.wp-env.inttest.json",
		"test:integration": "node tests/bin/integration.mjs",
		"test:e2e": "node tests/bin/e2e.mjs",
		"test:e2e:headed": "node tests/bin/e2e.mjs --headed",
		"test:e2e:ui": "node tests/bin/e2e.mjs --ui",
		"test:e2e:report": "playwright show-report"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.65.0",
		"@wordpress/env": "12.1.0"
	}
}
