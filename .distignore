# Files and folders left out of the release ZIP (composer run build:zip).
# One pattern per line. A pattern that starts with "/" is anchored to the plugin root and excludes
# that file or folder with everything inside it; any other pattern is matched (shell glob) against
# every path segment, at any depth. bin/build-zip.php also refuses a package that contains a
# development file even if it is missing from this list, or a languages/ folder: the plugin ships
# no translation files (translations come from translate.wordpress.org, AGENTS/I18N.md).

# Version control and editors
/.git
/.github
/.githooks
/.gitignore
/.gitattributes
/.distignore
/.editorconfig
/.vscode
/.idea
/.claude
/.codex
/.codex-tmp
.DS_Store
Thumbs.db
desktop.ini
.env
.env.*

# Development tools, caches and dependencies
/.phpunit.cache
/.composer-cache
/.composer-home
/bin
/build
/tests
/vendor
/node_modules
/package.json
/package-lock.json
/.wp-env.json
/.wp-env.tests.json
/.wp-env.override.json
/.wp-env.tests.override.json
/.wp-env.e2etest.json
/.wp-env.inttest.json
/.wp-env.e2etest.override.json
/.wp-env.inttest.override.json
/playwright.config.js
/playwright-report
/test-results
/composer.json
/composer.lock
/phpcs.xml.dist
/phpstan.neon.dist
/phpunit.xml
/phpunit-integration.xml

# AI context and private material
/AGENTS
/AGENTS.md
/CLAUDE.md
/DEV

# Repository-only documentation (docs/: guides for the developers of an importer, read on the repository;
# assets/screenshots/: images of the README, WordPress.org takes its screenshots from the SVN assets folder)
/README.md
/docs
/assets/screenshots
/CONTRIBUTING.md
/SECURITY.md
/VERSION.txt

# Leftovers
*.log
*.po~
*.pot~
*.orig
*.swp
*~
