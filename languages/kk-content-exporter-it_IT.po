#: includes/admin/class-feed-list.php:67
msgid "Access"
msgstr "Accesso"

#: includes/admin/class-feed-editor.php:257
msgid "Public: anyone can read the feed"
msgstr "Pubblico: chiunque può leggere il feed"

#: includes/admin/class-feed-editor.php:261
msgid "Authenticated: only an authorized user can read the feed"
msgstr "Autenticato: solo un utente autorizzato può leggere il feed"

#: includes/admin/class-feed-editor.php:267
msgid "Items per page"
msgstr "Elementi per pagina"

#: includes/admin/class-feed-editor.php:273
#: includes/admin/class-feed-list.php:68
msgid "Status"
msgstr "Stato"

#: includes/admin/class-feed-editor.php:277
msgid "Enable the feed"
msgstr "Attiva il feed"

#: includes/admin/class-feed-editor.php:279
msgid "A feed needs a slug and at least one source post type to be enabled."
msgstr "Per essere attivato, un feed ha bisogno di uno slug e di almeno un tipo di contenuto sorgente."

#: includes/admin/class-feed-editor.php:478
msgid "Address of the feed:"
msgstr "Indirizzo del feed:"

#: includes/admin/class-feed-editor.php:486
msgid "The address answers only while the feed is enabled."
msgstr "L'indirizzo risponde solo mentre il feed è attivo."

#: includes/admin/class-feed-editor.php:496
msgid "(required)"
msgstr "(obbligatorio)"

#: includes/admin/class-feed-editor.php:553
msgid "Enter a slug for the feed."
msgstr "Inserisci uno slug per il feed."

#: includes/admin/class-feed-editor.php:554
msgid "The slug can contain only lowercase letters, digits and single dashes between them."
msgstr "Lo slug può contenere solo lettere minuscole, cifre e singoli trattini tra di esse."

#. translators: %d: maximum number of characters of a slug.
#: includes/admin/class-feed-editor.php:557
#, php-format
msgid "The slug can have at most %d characters."
msgstr "Lo slug può avere al massimo %d caratteri."

#: includes/admin/class-feed-editor.php:560
msgid "This slug is reserved. Choose another one."
msgstr "Questo slug è riservato. Scegline un altro."

#: includes/admin/class-feed-editor.php:561
msgid "Another feed already uses this slug."
msgstr "Un altro feed usa già questo slug."

#: includes/admin/class-feed-editor.php:562
msgid "Choose at least one source post type."
msgstr "Scegli almeno un tipo di contenuto sorgente."

#: includes/admin/class-feed-editor.php:563
msgid "One of the source post types is not available. The previous sources were kept."
msgstr "Uno dei tipi di contenuto sorgente non è disponibile. Sono state mantenute le sorgenti precedenti."

#: includes/admin/class-feed-editor.php:564
msgid "The access value is not valid. The previous access was kept."
msgstr "Il valore di accesso non è valido. È stato mantenuto l'accesso precedente."

#. translators: %d: maximum number of items per page set in the plugin settings.
#: includes/admin/class-feed-editor.php:567
#, php-format
msgid "Items per page cannot be higher than the maximum set in the plugin settings (%d). The previous value was kept."
msgstr "Gli elementi per pagina non possono superare il massimo impostato nelle impostazioni del plugin (%d). È stato mantenuto il valore precedente."

#: includes/admin/class-feed-editor.php:570
msgid "Items per page must be a whole number of at least 1. The previous value was kept."
msgstr "Gli elementi per pagina devono essere un numero intero di almeno 1. È stato mantenuto il valore precedente."

#: includes/admin/class-feed-editor.php:571
msgid "The feed was saved disabled: set a valid slug and at least one source post type first."
msgstr "Il feed è stato salvato disattivato: imposta prima uno slug valido e almeno un tipo di contenuto sorgente."

