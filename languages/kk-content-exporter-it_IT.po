msgstr "Non hai i permessi per modificare i feed."

#: includes/rest/class-admin-routes.php:255
#: includes/rest/class-admin-routes.php:334
msgid "None of the requested post types can be exported."
msgstr "Nessuno dei tipi di contenuto richiesti può essere esportato."

#: includes/rest/class-admin-routes.php:265
msgid "The post type to preview is not one of the post types of the feed."
msgstr "Il tipo di contenuto da mostrare nell'anteprima non è uno di quelli del feed."

#: includes/rest/class-admin-routes.php:275
msgid "The mapping is not valid."
msgstr "Il mapping non è valido."

#: includes/rest/class-admin-routes.php:289
