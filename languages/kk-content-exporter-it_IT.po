msgstr "Il numero massimo di elementi che un feed può servire in una pagina. Non c'è un limite superiore: valori molto alti rendono ogni risposta pesante e sono sotto la tua responsabilità."

#: includes/admin/class-settings-page.php:112
msgid "Uninstall"
msgstr "Disinstallazione"

#: includes/admin/class-settings-page.php:114
msgid "Delete all the data of the plugin when the plugin is deleted"
msgstr "Elimina tutti i dati del plugin quando il plugin viene eliminato"

#: includes/admin/class-settings-page.php:115
msgid "The feeds, their settings, these settings and the capability are removed permanently. Leave it off to keep them."
msgstr "I feed, le loro impostazioni, queste impostazioni e la capability vengono rimossi in modo permanente. Lascialo disattivato per conservarli."

#: includes/admin/class-settings-page.php:144
