msgstr "Elemento da visualizzare in anteprima; se manca, l'ultimo elemento pubblicato di ogni tipo di contenuto."

#: includes/rest/class-admin-routes.php:107
msgid "Post types of the feed."
msgstr "Tipi di contenuto del feed."

#: includes/rest/class-admin-routes.php:133
