msgstr ""

#: includes/admin/class-feed-editor.php:87
msgid "Feed settings"
msgstr "Impostazioni del feed"

#: includes/admin/class-feed-editor.php:132
#: includes/admin/class-feed-list.php:63
msgid "Slug"
msgstr "Slug"

#: includes/admin/class-feed-editor.php:135
msgid "Last part of the address of the feed. Lowercase letters, digits and dashes. Leave it empty to use the title."
msgstr "Ultima parte dell'indirizzo del feed. Lettere minuscole, cifre e trattini. Lascia vuoto per usare il titolo."

#: includes/admin/class-feed-editor.php:139
#: includes/admin/class-feed-list.php:64
msgid "Source"
msgstr "Sorgente"

#: includes/admin/class-feed-editor.php:142
msgid "&mdash; Select a post type &mdash;"
msgstr "&mdash; Seleziona un tipo di contenuto &mdash;"

#: includes/admin/class-feed-editor.php:147
msgid "The post type whose published content the feed exports."
msgstr "Il tipo di contenuto di cui il feed esporta i contenuti pubblicati."

#: includes/admin/class-feed-editor.php:151
#: includes/admin/class-feed-editor.php:154
#: includes/admin/class-feed-list.php:65
msgid "Access"
msgstr "Accesso"

#: includes/admin/class-feed-editor.php:157
msgid "Public: anyone can read the feed"
msgstr "Pubblico: chiunque può leggere il feed"

#: includes/admin/class-feed-editor.php:161
msgid "Authenticated: only an authorized user can read the feed"
msgstr "Autenticato: solo un utente autorizzato può leggere il feed"

#: includes/admin/class-feed-editor.php:167
msgid "Items per page"
msgstr "Elementi per pagina"

#: includes/admin/class-feed-editor.php:173
#: includes/admin/class-feed-list.php:66
msgid "Status"
msgstr "Stato"

#: includes/admin/class-feed-editor.php:177
msgid "Enable the feed"
msgstr "Attiva il feed"

#: includes/admin/class-feed-editor.php:179
msgid "A feed needs a slug and a source post type to be enabled."
msgstr "Per attivare un feed servono uno slug e un tipo di contenuto sorgente."

#: includes/admin/class-feed-editor.php:395
msgid "Enter a slug for the feed."
msgstr "Inserisci uno slug per il feed."

#: includes/admin/class-feed-editor.php:396
msgid "The slug can contain only lowercase letters, digits and single dashes between them."
msgstr "Lo slug può contenere solo lettere minuscole, cifre e singoli trattini tra di esse."

#. translators: %d: maximum number of characters of a slug.
#: includes/admin/class-feed-editor.php:399
#, php-format
msgid "The slug can have at most %d characters."
msgstr "Lo slug può avere al massimo %d caratteri."

#: includes/admin/class-feed-editor.php:402
msgid "This slug is reserved. Choose another one."
msgstr "Questo slug è riservato. Scegline un altro."

#: includes/admin/class-feed-editor.php:403
msgid "Another feed already uses this slug."
msgstr "Un altro feed usa già questo slug."

#: includes/admin/class-feed-editor.php:404
msgid "The source post type is not available. The previous source was kept."
msgstr "Il tipo di contenuto sorgente non è disponibile. È stato mantenuto quello precedente."

#: includes/admin/class-feed-editor.php:405
msgid "The access value is not valid. The previous access was kept."
msgstr "Il valore di accesso non è valido. È stato mantenuto l'accesso precedente."

#: includes/admin/class-feed-editor.php:406
msgid "Items per page must be a whole number of at least 1. The previous value was kept."
msgstr "Gli elementi per pagina devono essere un numero intero di almeno 1. È stato mantenuto il valore precedente."

#: includes/admin/class-feed-editor.php:407
msgid "The feed was saved disabled: set a valid slug and a source post type first."
msgstr "Il feed è stato salvato disattivato: imposta prima uno slug valido e un tipo di contenuto sorgente."

#: includes/admin/class-feed-list.php:148
msgid "Authenticated"
msgstr "Autenticato"

#: includes/admin/class-feed-list.php:149
msgid "Public"
msgstr "Pubblico"

#: includes/admin/class-feed-list.php:160
msgid "Active"
msgstr "Attivo"

#: includes/admin/class-feed-list.php:161
msgid "Disabled"
msgstr "Disattivato"

#: includes/admin/class-feed-list.php:173
msgid "Not set"
msgstr "Non impostato"

#: includes/class-feed-post-type.php:80
msgid "Configurations of the JSON feeds."
msgstr "Configurazioni dei feed JSON."

#: includes/class-feed-post-type.php:261
msgid "Feeds"
msgstr "Feed"

#: includes/class-feed-post-type.php:262
msgid "Feed"
msgstr "Feed"

#: includes/class-feed-post-type.php:263
msgid "Content Exporter"
msgstr "Content Exporter"

#: includes/class-feed-post-type.php:264
msgid "Add New"
msgstr "Aggiungi"

#: includes/class-feed-post-type.php:265
msgid "Add New Feed"
msgstr "Aggiungi un feed"

#: includes/class-feed-post-type.php:266
msgid "Edit Feed"
msgstr "Modifica il feed"

#: includes/class-feed-post-type.php:267
msgid "New Feed"
msgstr "Nuovo feed"

#: includes/class-feed-post-type.php:268
msgid "View Feed"
msgstr "Visualizza il feed"

#: includes/class-feed-post-type.php:269
msgid "Search Feeds"
msgstr "Cerca feed"

#: includes/class-feed-post-type.php:270
msgid "No feeds found."
msgstr "Nessun feed trovato."

#: includes/class-feed-post-type.php:271
msgid "No feeds found in Trash."
msgstr "Nessun feed nel cestino."

#: includes/class-feed-post-type.php:272
msgid "All Feeds"
msgstr "Tutti i feed"

#: includes/class-plugin.php:101
msgid "Development version: no feeds can be configured yet."
msgstr "Versione di sviluppo: non è ancora possibile configurare feed."
