#. Plugin Name of the plugin
#: kk-content-exporter.php:3
msgid "KK Content Exporter"
msgstr "KK Content Exporter"

#. Plugin URI of the plugin
#: kk-content-exporter.php:4
msgid "https://github.com/ilclaudio/kk-content-exporter/"
msgstr "https://github.com/ilclaudio/kk-content-exporter/"

#. Description of the plugin
#: kk-content-exporter.php:5
msgid "Exposes published content of a chosen post type as configurable, read-only JSON feeds."
msgstr "Espone i contenuti pubblicati di un tipo di contenuto scelto come feed JSON configurabili e in sola lettura."

#. Author of the plugin
#: kk-content-exporter.php:9
msgid "IoClaudio"
msgstr "IoClaudio"

#. Author URI of the plugin
#: kk-content-exporter.php:10
msgid "https://www.claudiobattaglino.it"
msgstr "https://www.claudiobattaglino.it"

#: includes/admin/class-feed-editor.php:106
msgid "Feed settings"
msgstr "Impostazioni del feed"

#. translators: %s: key of a post type saved for the feed that no longer exists or is no longer public.
#: includes/admin/class-feed-editor.php:193
#, php-format
msgid "%s (not available)"
msgstr "%s (non disponibile)"

#: includes/admin/class-feed-editor.php:218
#: includes/sources/class-core-provider.php:40
msgid "Slug"
msgstr "Slug"

#: includes/admin/class-feed-editor.php:221
msgid "Last part of the address of the feed. Lowercase letters, digits and dashes."
msgstr "Ultima parte dell'indirizzo del feed. Lettere minuscole, cifre e trattini."

#: includes/admin/class-feed-editor.php:226
#: includes/admin/class-feed-list.php:66
msgid "Source"
msgstr "Sorgente"

#: includes/admin/class-feed-editor.php:232
msgid "Filter post types"
msgstr "Filtra i tipi di contenuto"

#: includes/admin/class-feed-editor.php:234
msgid "Shows only the post types whose name contains the text. Checked post types are always shown."
msgstr "Mostra solo i tipi di contenuto il cui nome contiene il testo. I tipi spuntati sono sempre mostrati."

#: includes/admin/class-feed-editor.php:238
msgid "Source post types"
msgstr "Tipi di contenuto sorgente"

#: includes/admin/class-feed-editor.php:246
msgid "The post types whose published content the feed exports. Items of different types share the same response, order and pages."
msgstr "I tipi di contenuto i cui contenuti pubblicati vengono esportati dal feed. Gli elementi di tipi diversi condividono la stessa risposta, lo stesso ordinamento e le stesse pagine."

#: includes/admin/class-feed-editor.php:250
#: includes/admin/class-feed-editor.php:253
#: includes/admin/class-feed-list.php:67
msgid "Access"
msgstr "Accesso"

#: includes/admin/class-feed-editor.php:256
msgid "Public: anyone can read the feed"
msgstr "Pubblico: chiunque può leggere il feed"

#: includes/admin/class-feed-editor.php:260
msgid "Authenticated: only an authorized user can read the feed"
msgstr "Autenticato: solo un utente autorizzato può leggere il feed"

#: includes/admin/class-feed-editor.php:266
msgid "Items per page"
msgstr "Elementi per pagina"

#: includes/admin/class-feed-editor.php:272
#: includes/admin/class-feed-list.php:68
msgid "Status"
msgstr "Stato"

#: includes/admin/class-feed-editor.php:276
msgid "Enable the feed"
msgstr "Attiva il feed"

#: includes/admin/class-feed-editor.php:278
msgid "A feed needs a slug and at least one source post type to be enabled."
msgstr "Per essere attivato, un feed ha bisogno di uno slug e di almeno un tipo di contenuto sorgente."

#: includes/admin/class-feed-editor.php:474
msgid "Address of the feed:"
msgstr "Indirizzo del feed:"

#: includes/admin/class-feed-editor.php:482
msgid "The address answers only while the feed is enabled."
msgstr "L'indirizzo risponde solo mentre il feed è attivo."

#: includes/admin/class-feed-editor.php:492
msgid "(required)"
msgstr "(obbligatorio)"

#: includes/admin/class-feed-editor.php:549
msgid "Enter a slug for the feed."
msgstr "Inserisci uno slug per il feed."

#: includes/admin/class-feed-editor.php:550
msgid "The slug can contain only lowercase letters, digits and single dashes between them."
msgstr "Lo slug può contenere solo lettere minuscole, cifre e singoli trattini tra di esse."

#. translators: %d: maximum number of characters of a slug.
#: includes/admin/class-feed-editor.php:553
#, php-format
msgid "The slug can have at most %d characters."
msgstr "Lo slug può avere al massimo %d caratteri."

#: includes/admin/class-feed-editor.php:556
msgid "This slug is reserved. Choose another one."
msgstr "Questo slug è riservato. Scegline un altro."

#: includes/admin/class-feed-editor.php:557
msgid "Another feed already uses this slug."
msgstr "Un altro feed usa già questo slug."

#: includes/admin/class-feed-editor.php:558
msgid "Choose at least one source post type."
msgstr "Scegli almeno un tipo di contenuto sorgente."

#: includes/admin/class-feed-editor.php:559
msgid "One of the source post types is not available. The previous sources were kept."
msgstr "Uno dei tipi di contenuto sorgente non è disponibile. Sono state mantenute le sorgenti precedenti."

#: includes/admin/class-feed-editor.php:560
msgid "The access value is not valid. The previous access was kept."
msgstr "Il valore di accesso non è valido. È stato mantenuto l'accesso precedente."

#. translators: %d: maximum number of items per page set in the plugin settings.
#: includes/admin/class-feed-editor.php:563
#, php-format
msgid "Items per page cannot be higher than the maximum set in the plugin settings (%d). The previous value was kept."
msgstr "Gli elementi per pagina non possono superare il massimo impostato nelle impostazioni del plugin (%d). È stato mantenuto il valore precedente."

#: includes/admin/class-feed-editor.php:566
msgid "Items per page must be a whole number of at least 1. The previous value was kept."
msgstr "Gli elementi per pagina devono essere un numero intero di almeno 1. È stato mantenuto il valore precedente."

#: includes/admin/class-feed-editor.php:567
msgid "The feed was saved disabled: set a valid slug and at least one source post type first."
msgstr "Il feed è stato salvato disattivato: imposta prima uno slug valido e almeno un tipo di contenuto sorgente."

#: includes/admin/class-feed-list.php:65
msgid "Endpoint"
msgstr "Endpoint"

#: includes/admin/class-feed-list.php:182
msgid "Authenticated"
msgstr "Autenticato"

#: includes/admin/class-feed-list.php:183
msgid "Public"
msgstr "Pubblico"

#: includes/admin/class-feed-list.php:194
msgid "Active"
msgstr "Attivo"

#: includes/admin/class-feed-list.php:195
msgid "Disabled"
msgstr "Disattivato"

#: includes/admin/class-feed-list.php:207
msgid "Not set"
msgstr "Non impostato"

#: includes/admin/class-mapping-box.php:54
msgid "Mapping"
msgstr "Mapping"

#: includes/admin/class-mapping-box.php:86
msgid "The mapping is not saved yet: in this development version the rows built here are lost when the feed is updated or the page is left."
msgstr "Il mapping non viene ancora salvato: in questa versione di sviluppo le righe costruite qui si perdono quando si aggiorna il feed o si lascia la pagina."

#: includes/admin/class-mapping-box.php:87
msgid "Each row writes one key in every exported item: choose the key, the field it reads and how the value is written. A key without a value is written with null, so every item has the same keys."
msgstr "Ogni riga scrive una chiave in ogni elemento esportato: scegli la chiave, il campo che legge e come viene scritto il valore. Una chiave senza valore viene scritta con null, così ogni elemento ha le stesse chiavi."

#: includes/admin/class-mapping-box.php:90
msgid "The mapping editor needs JavaScript. Without it, saving the feed keeps the saved mapping unchanged."
msgstr "L'editor del mapping richiede JavaScript. Senza, salvando il feed il mapping salvato resta invariato."

#: includes/admin/class-settings-page.php:64
#: includes/admin/class-settings-page.php:147
msgid "Content Exporter settings"
msgstr "Impostazioni di Content Exporter"

#: includes/admin/class-settings-page.php:65
msgid "Settings"
msgstr "Impostazioni"

#: includes/admin/class-settings-page.php:93
msgid "Endpoints"
msgstr "Endpoint"

#: includes/admin/class-settings-page.php:95
msgid "Serve the feeds"
msgstr "Servi i feed"

#: includes/admin/class-settings-page.php:96
msgid "Turn it off to stop every feed from answering. The feeds and their settings are kept."
msgstr "Disattivalo per fermare la risposta di tutti i feed. I feed e le loro impostazioni vengono conservati."

#: includes/admin/class-settings-page.php:99
msgid "Authentication"
msgstr "Autenticazione"

#: includes/admin/class-settings-page.php:101
msgid "Require authentication for all feeds"
msgstr "Richiedi l'autenticazione per tutti i feed"

#: includes/admin/class-settings-page.php:102
msgid "It takes precedence over the access chosen in each feed."
msgstr "Prevale sull'accesso scelto nel singolo feed."

#: includes/admin/class-settings-page.php:105
msgid "Maximum items per page"
msgstr "Massimo di elementi per pagina"

#: includes/admin/class-settings-page.php:108
msgid "The largest number of items that a feed can serve in one page. There is no upper limit: very high values make every response heavy and are your responsibility."
msgstr "Il numero massimo di elementi che un feed può servire in una pagina. Non c'è un limite superiore: valori molto alti rendono ogni risposta pesante e sono sotto la tua responsabilità."

#: includes/admin/class-settings-page.php:111
msgid "Uninstall"
msgstr "Disinstallazione"

#: includes/admin/class-settings-page.php:113
msgid "Delete all the data of the plugin when the plugin is deleted"
msgstr "Elimina tutti i dati del plugin quando il plugin viene eliminato"

#: includes/admin/class-settings-page.php:114
msgid "The feeds, their settings, these settings and the capability are removed permanently. Leave it off to keep them."
msgstr "I feed, le loro impostazioni, queste impostazioni e la capability vengono rimossi in modo permanente. Lascialo disattivato per conservarli."

#: includes/admin/class-settings-page.php:143
msgid "You do not have permission to access this page."
msgstr "Non hai il permesso di accedere a questa pagina."

#: includes/admin/class-settings-page.php:218
msgid "The REST API seems to be blocked for anonymous requests, probably by a security plugin or a setting of the site. Public feeds cannot be read until anonymous requests to the REST API are allowed."
msgstr "L'API REST sembra bloccata per le richieste anonime, probabilmente da un plugin di sicurezza o da un'impostazione del sito. I feed pubblici non possono essere letti finché le richieste anonime all'API REST non sono consentite."

#: includes/admin/class-settings-page.php:222
msgid "Some feeds require authentication, but Application Passwords are not available on this site: WordPress offers them only over HTTPS or in a local environment. Authenticated feeds cannot be read until then."
msgstr "Alcuni feed richiedono l'autenticazione, ma le Application Password non sono disponibili su questo sito: WordPress le offre solo tramite HTTPS o in un ambiente locale. I feed autenticati non possono essere letti finché non lo sono."

