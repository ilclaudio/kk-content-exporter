#: assets/js/feed-mapping.js:189
msgid "Enter a key."
msgstr "Inserisci una chiave."

#. translators: %d: maximum number of characters of a key.
#: assets/js/feed-mapping.js:193
#, js-format
msgid "Use at most %d characters."
msgstr "Usa al massimo %d caratteri."

#: assets/js/feed-mapping.js:196
msgid "Use only letters, digits, underscores, dots and dashes."
msgstr "Usa solo lettere, cifre, trattini bassi, punti e trattini."

#: assets/js/feed-mapping.js:199
msgid "A key cannot be made only of digits."
msgstr "Una chiave non può essere composta solo da cifre."

#: assets/js/feed-mapping.js:202
msgid "Another row already uses this key."
msgstr "Un'altra riga usa già questa chiave."

#: assets/js/feed-mapping.js:228
msgid "No rows yet. Add a row to choose what the feed exports."
msgstr "Ancora nessuna riga. Aggiungi una riga per scegliere cosa esporta il feed."

#: assets/js/feed-mapping.js:229
msgid "Add row"
msgstr "Aggiungi riga"

#: assets/js/feed-mapping.js:391
msgid "For all post types"
msgstr "Per tutti i tipi di contenuto"

#. translators: %s: key of a post type that is not checked in the settings of the feed.
#: assets/js/feed-mapping.js:395
#, js-format
msgid "For %s (not checked)"
msgstr "Per %s (non spuntato)"

#. translators: %s: label of a post type.
#: assets/js/feed-mapping.js:398
#, js-format
msgid "For %s"
msgstr "Per %s"

#: assets/js/feed-mapping.js:410
msgid "— Choose a field —"
msgstr "— Scegli un campo —"

#. translators: %s: identifier of a field that the post types of the feed do not offer.
#: assets/js/feed-mapping.js:414
#, js-format
msgid "%s (not offered by the checked post types)"
msgstr "%s (non offerto dai tipi di contenuto spuntati)"

#: assets/js/feed-mapping.js:417
msgid "Common fields"
msgstr "Campi comuni"

#. translators: %s: label of a post type.
#: assets/js/feed-mapping.js:420
#, js-format
msgid "Fields of %s"
msgstr "Campi di %s"

#. translators: %d: position of the row.
#: assets/js/feed-mapping.js:478
#, js-format
msgid "Row %d (no key)"
msgstr "Riga %d (senza chiave)"

#. translators: 1: position of the row, 2: output key of the row.
#: assets/js/feed-mapping.js:481
#, js-format
msgid "Row %1$d: %2$s"
msgstr "Riga %1$d: %2$s"

#. translators: %d: position of a fallback field in its chain (2 for the first fallback).
#: assets/js/feed-mapping.js:506
#, js-format
msgid "Otherwise, field %d"
msgstr "Altrimenti, campo %d"

#. translators: 1: position of the field in its chain, 2: name of the chain, for example "For all post types".
#: assets/js/feed-mapping.js:511
#, js-format
msgid "Move field %1$d up (%2$s)"
msgstr "Sposta su il campo %1$d (%2$s)"

#. translators: 1: position of the field in its chain, 2: name of the chain, for example "For all post types".
#: assets/js/feed-mapping.js:513
#, js-format
msgid "Move field %1$d down (%2$s)"
msgstr "Sposta giù il campo %1$d (%2$s)"

#. translators: 1: position of the field in its chain, 2: name of the chain, for example "For all post types".
#: assets/js/feed-mapping.js:515
#, js-format
msgid "Remove field %1$d (%2$s)"
msgstr "Rimuovi il campo %1$d (%2$s)"

#. translators: %s: name of the chain, for example "For all post types".
#: assets/js/feed-mapping.js:525
#, js-format
msgid "Add a fallback field (%s)"
msgstr "Aggiungi un campo di ripiego (%s)"

#. translators: %s: post types the exception applies to, for example "For Posts".
#: assets/js/feed-mapping.js:528
#: assets/js/feed-mapping.js:560
#, js-format
msgid "Remove the exception: %s"
msgstr "Rimuovi l'eccezione: %s"

#. translators: %s: name of the scope, for example "For all post types".
#: assets/js/feed-mapping.js:557
#, js-format
msgid "Value (%s)"
msgstr "Valore (%s)"

#: assets/js/feed-mapping.js:584
msgid "Different for"
msgstr "Diverso per"

#: assets/js/feed-mapping.js:585
msgid "Add exception"
msgstr "Aggiungi eccezione"

#: assets/js/feed-mapping.js:605
msgid "Raw content"
msgstr "Contenuto grezzo"

#: assets/js/feed-mapping.js:607
msgid "The text as stored in the database: blocks are not turned into HTML and links stay as they are."
msgstr "Il testo come è salvato nel database: i blocchi non diventano HTML e i link restano come sono."

#: assets/js/feed-mapping.js:614
msgid "Run the shortcodes"
msgstr "Esegui gli shortcode"

#: assets/js/feed-mapping.js:617
msgid "Not used with the raw content."
msgstr "Non usato con il contenuto grezzo."

#: assets/js/feed-mapping.js:618
msgid "Off: shortcodes are removed. On: the shortcodes of other plugins run while the feed is read, as for a visitor; they can add content you do not expect or slow the feed down. Turn it on only for shortcodes you know."
msgstr "Spento: gli shortcode vengono tolti. Acceso: gli shortcode degli altri plugin vengono eseguiti mentre si legge il feed, come per un visitatore; possono aggiungere contenuti inattesi o rallentare il feed. Accendilo solo per shortcode che conosci."

#: assets/js/feed-mapping.js:627
msgid "The author archive URL usually contains the login name of the author: it is exported only after an explicit confirmation, asked when the feed is saved."
msgstr "L'URL dell'archivio dell'autore di solito contiene il nome di login dell'autore: viene esportato solo dopo una conferma esplicita, chiesta quando si salva il feed."

#. translators: %s: label of a field whose name looks sensitive or personal.
#: assets/js/feed-mapping.js:631
#, js-format
msgid "%s looks like sensitive or personal data: in a public feed anyone can read it. It is exported only after an explicit confirmation, asked when the feed is saved."
msgstr "%s sembra un dato sensibile o personale: in un feed pubblico chiunque può leggerlo. Viene esportato solo dopo una conferma esplicita, chiesta quando si salva il feed."

#: assets/js/feed-mapping.js:664
msgid "JSON key"
msgstr "Chiave JSON"

#: assets/js/feed-mapping.js:666
msgid "Rule"
msgstr "Regola"

#: assets/js/feed-mapping.js:668
msgid "Output type"
msgstr "Tipo di uscita"

#: assets/js/feed-mapping.js:673
msgid "This rule cannot be edited here yet and is kept unchanged."
msgstr "Questa regola non si può ancora modificare qui e resta invariata."

#. translators: %d: position of the row.
#: assets/js/feed-mapping.js:704
#, js-format
msgid "Move row %d up"
msgstr "Sposta su la riga %d"

#. translators: %d: position of the row.
#: assets/js/feed-mapping.js:706
#, js-format
msgid "Move row %d down"
msgstr "Sposta giù la riga %d"

#. translators: %d: position of the row.
#: assets/js/feed-mapping.js:708
#, js-format
msgid "Remove row %d"
msgstr "Rimuovi la riga %d"

#. translators: %d: maximum number of rows of a mapping.
#: assets/js/feed-mapping.js:754
#, js-format
msgid "A mapping can have at most %d rows."
msgstr "Un mapping può avere al massimo %d righe."

#. translators: %d: position of the new row.
#: assets/js/feed-mapping.js:814
#, js-format
msgid "Row %d added."
msgstr "Riga %d aggiunta."

#. translators: %d: position of the removed row.
#: assets/js/feed-mapping.js:835
#, js-format
msgid "Row %d removed."
msgstr "Riga %d rimossa."

#. translators: %d: new position of the moved row.
#: assets/js/feed-mapping.js:851
#, js-format
