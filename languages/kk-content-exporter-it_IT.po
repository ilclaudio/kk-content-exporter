#, js-format
msgid "Row moved to position %d."
msgstr "Riga spostata in posizione %d."

#: assets/js/feed-mapping.js:2379
msgid "Line added to the table."
msgstr "Voce aggiunta alla tabella."

#: assets/js/feed-mapping.js:2387
msgid "Line removed from the table."
msgstr "Voce rimossa dalla tabella."

#. translators: %d: new position of the moved line in the table of a lookup rule.
#: assets/js/feed-mapping.js:2401
#, js-format
msgid "Line moved to position %d of the table."
msgstr "Voce spostata alla posizione %d della tabella."

#. translators: %s: placeholder inserted in a template, for example {core.title}.
#: assets/js/feed-mapping.js:2444
#, js-format
msgid "Inserted %s."
msgstr "Inserito %s."

#. translators: %s: name of the exception, for example "For Posts".
#: assets/js/feed-mapping.js:2467
#, js-format
msgid "Exception added: %s."
msgstr "Eccezione aggiunta: %s."

#. translators: %s: name of the exception, for example "For Posts".
#: assets/js/feed-mapping.js:2482
#, js-format
msgid "Exception removed: %s."
msgstr "Eccezione rimossa: %s."

#: assets/js/feed-mapping.js:2496
msgid "Fallback field added."
msgstr "Campo di ripiego aggiunto."

#: assets/js/feed-mapping.js:2504
msgid "Field removed from the chain."
msgstr "Campo tolto dalla catena."

#. translators: %d: new position of the moved field in its chain.
#: assets/js/feed-mapping.js:2519
#, js-format
msgid "Field moved to position %d of the chain."
msgstr "Campo spostato in posizione %d della catena."

#: assets/js/feed-mapping.js:2667
msgid "Type the post meta key below the field."
msgstr "Scrivi la chiave del meta del contenuto sotto il campo."

#. translators: 1: position of the row, 2: error message about its key.
#: assets/js/feed-mapping.js:2676
#, js-format
msgid "Error in row %1$d: %2$s"
msgstr "Errore nella riga %1$d: %2$s"

#. translators: %s: name of the rule, for example "Fixed value".
#: assets/js/feed-mapping.js:2720
#, js-format
msgid "Rule changed to %s. Only the settings of this rule are saved."
msgstr "Regola cambiata in %s. Vengono salvate solo le impostazioni di questa regola."

#: assets/js/feed-mapping.js:2778
msgid "Use this key"
msgstr "Usa questa chiave"

#: assets/js/feed-mapping.js:2780
msgid "Post meta key"
msgstr "Chiave del meta del contenuto"

#: assets/js/feed-mapping.js:2784
msgid "For a custom field that is not in the lists. If the item has no such field, the value is null."
msgstr "Per un campo personalizzato che non è negli elenchi. Se l'elemento non ha questo campo, il valore è null."

#. translators: %s: meta keys that cannot be used, separated by commas.
#: assets/js/feed-mapping.js:2839
#, js-format
msgid "This key cannot be used: %s. Keys of WordPress and of this plugin, and keys with spaces or special characters, are not allowed."
msgstr "Questa chiave non può essere usata: %s. Le chiavi di WordPress e di questo plugin, e quelle con spazi o caratteri speciali, non sono ammesse."

#. translators: %s: meta key.
#: assets/js/feed-mapping.js:2863
#, js-format
msgid "Field added: %s."
msgstr "Campo aggiunto: %s."

#: assets/js/feed-mapping.js:2880
msgid "Type the post meta key first."
msgstr "Scrivi prima la chiave del meta del contenuto."

#: assets/js/feed-mapping.js:2884
msgid "Check at least one post type of the feed first."
msgstr "Seleziona prima almeno un tipo di contenuto del feed."

#: assets/js/feed-mapping.js:2954
msgid "The fields of the selected post types could not be loaded. The previous list is kept."
msgstr "Non è stato possibile caricare i campi dei tipi di contenuto scelti. Resta l'elenco precedente."
