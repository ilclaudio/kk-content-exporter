#: includes/rest/class-admin-routes.php:248
#: includes/rest/class-admin-routes.php:317
msgid "None of the requested post types can be exported."
msgstr "Nessuno dei tipi di contenuto richiesti può essere esportato."

#: includes/rest/class-admin-routes.php:258
msgid "The mapping is not valid."
msgstr "Il mapping non è valido."

#: includes/rest/class-admin-routes.php:272
msgid "No published item of the feed post types has this ID."
msgstr "Nessun elemento pubblicato dei tipi di contenuto del feed ha questo ID."

#: includes/rest/class-admin-routes.php:416
msgid "In this item the author archive URL contains the login name of the author: whoever reads the feed learns it."
msgstr "In questo elemento l'URL dell'archivio dell'autore contiene il nome di accesso dell'autore: chi legge il feed lo conosce."

#: includes/rest/class-feed-routes.php:94
msgid "Slug of the feed."
msgstr "Slug del feed."

#: includes/rest/class-feed-routes.php:98
msgid "Page of the items, from 1."
msgstr "Pagina degli elementi, da 1."

#: includes/rest/class-feed-routes.php:105
msgid "Items per page; by default the value of the feed, at most the maximum of the settings."
msgstr "Elementi per pagina; per impostazione predefinita il valore del feed, al massimo il valore massimo delle impostazioni."

#: includes/rest/class-feed-routes.php:110
msgid "Items modified at or after this moment (included), for example 2026-11-01T10:00:00Z."
msgstr "Elementi modificati a partire da questo momento (incluso), per esempio 2026-11-01T10:00:00Z."

#: includes/rest/class-feed-routes.php:111
msgid "Items modified before this moment (excluded), for example 2026-11-01T10:00:00Z."
msgstr "Elementi modificati prima di questo momento (escluso), per esempio 2026-11-01T10:00:00Z."

#: includes/rest/class-feed-routes.php:112
msgid "Items published at or after this moment (included), for example 2026-11-01T10:00:00Z."
msgstr "Elementi pubblicati a partire da questo momento (incluso), per esempio 2026-11-01T10:00:00Z."

#: includes/rest/class-feed-routes.php:150
msgid "Sorry, you are not allowed to read this feed."
msgstr "Non hai il permesso di leggere questo feed."

#: includes/rest/class-feed-routes.php:157
msgid "Authentication with an Application Password is required to read this feed."
msgstr "Per leggere questo feed è necessaria l'autenticazione con una password per le applicazioni."

#. translators: %d: maximum items per page set in the settings of the plugin.
#: includes/rest/class-feed-routes.php:241
#, php-format
msgid "per_page must be at most %d."
msgstr "per_page deve essere al massimo %d."

#. translators: %s: name of a parameter of the feed endpoint.
