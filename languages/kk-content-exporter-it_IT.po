#. Plugin Name of the plugin
#: kk-content-exporter.php:3
msgid "KK Content Exporter"
msgstr "KK Content Exporter"

#. Plugin URI of the plugin
#: kk-content-exporter.php:4
msgid "https://github.com/ilclaudio/kk-content-exporter/"
msgstr ""

#. Description of the plugin
#: kk-content-exporter.php:5
msgid "Exposes published content of a chosen post type as configurable, read-only JSON feeds."
msgstr "Espone i contenuti pubblicati di un tipo di contenuto scelto come feed JSON configurabili e in sola lettura."

#. Author of the plugin
#: kk-content-exporter.php:9
msgid "IoClaudio"
msgstr ""

