msgstr "Non hai i permessi per modificare i feed."

#: includes/rest/class-admin-routes.php:199
msgid "The mapping is not valid."
msgstr "Il mapping non è valido."

#: includes/rest/class-admin-routes.php:211
msgid "None of the requested post types can be exported."
msgstr "Nessuno dei tipi di contenuto richiesti può essere esportato."

#: includes/rest/class-admin-routes.php:224
msgid "No published item of the feed post types has this ID."
msgstr "Nessun elemento pubblicato dei tipi di contenuto del feed ha questo ID."

